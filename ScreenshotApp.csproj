<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 独自アイコンを使いたい場合は app.ico を配置し、下の行のコメントを外してください -->
    <!-- <ApplicationIcon>app.ico</ApplicationIcon> -->

    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- タスクトレイ常駐アプリなのでコンソールウィンドウを表示しない -->
    <StartupObject>ScreenshotApp.Program</StartupObject>
    <AssemblyName>ScreenshotApp</AssemblyName>
    <RootNamespace>ScreenshotApp</RootNamespace>
  </PropertyGroup>

</Project>
